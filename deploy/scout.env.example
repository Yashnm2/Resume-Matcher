DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres
REDIS_URL=redis://default:PASSWORD@HOST:PORT/0
AUTH_REQUIRED=true
SUPABASE_URL=https://PROJECT.supabase.co
# Optional for legacy HS256 projects; leave blank to use Supabase JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
ENCRYPTION_SECRET=generate-once-with-Fernet.generate_key-and-share-across-services
SCOUT_TIMEZONE=Asia/Singapore
INBOUND_EMAIL_SECRET=
LLM_PROVIDER=openai
LLM_API_KEY=
RESEND_API_KEY=
NOTIFICATION_EMAIL=
NOTIFICATION_FROM_EMAIL=Resume Matcher <notifications@example.com>
PUBLIC_APP_URL=https://resume-matcher.example.com
BACKEND_ORIGIN=http://api.railway.internal:8000
NEXT_PUBLIC_API_URL=/
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=application-packs
SENTRY_DSN=
DEPLOYMENT_ENVIRONMENT=production
